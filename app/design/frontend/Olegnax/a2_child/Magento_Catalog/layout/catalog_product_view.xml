<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View" name="freeshipping"
                   template="Magento_Catalog::product/view/freeshipping.phtml" after="-"/>
        </referenceBlock>
        <referenceBlock name="product.info.sku" remove="true"/>

        <move element="product.info.main" destination="content" after="product.info.media" />
        <move element="freeshipping" destination="product.info.main" after="product.info.price"/>
        <move element="product.info.overview" destination="product.info.main" after="product.info"/>
    </body>
</page>
