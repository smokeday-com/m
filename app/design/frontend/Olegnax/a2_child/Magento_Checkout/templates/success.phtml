use Magento\Checkout\Block\Onepage\Success;

// @codingStandardsIgnoreFile

?>
<?php /** @var $block Success */ ?>
<?php
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$order = $objectManager->create('Magento\Sales\Model\Order')->loadByIncrementId($block->getOrderId());
$orderAmount = $order->getGrandTotal();
$customerEmail = $order->getCustomerEmail();
?>
<div class="checkout-success">
    <?php if ($block->getOrderId()): ?>
        <?php if ($block->getCanViewOrder()) : ?>
            <p class="your-order-is"><?= $block->escapeHtml(__('Your order number is: %1', sprintf('<a href="%s" class="order-number"><strong>%s</strong></a>', $block->escapeUrl($block->getViewOrderUrl()), $block->getOrderId())), ['a', 'strong']) ?></p>
        <?php else : ?>
            <p class="your-order-is"><?= $block->escapeHtml(__('Your order # is: %1', sprintf('<span class="order-number">%s</span>', $block->getOrderId())), ['span']) ?></p>
        <?php endif; ?>
        <p><?= $block->escapeHtml(__('We\'ll email you an order confirmation with details and tracking info.')) ?></p>
    <?php endif; ?>

    <?= $block->getAdditionalInfoHtml() ?>

    <div class="actions-toolbar">
        <div class="primary">
            <a class="action primary continue"
               href="<?= $block->escapeUrl($block->getContinueUrl()) ?>"><span><?= $block->escapeHtml(__('Continue Shopping')) ?></span></a>
        </div>
    </div>
</div>
