<script>
    require([
        'jquery',
        'domReady!'// wait for dom ready
    ], function ($) {

        $('.button-slide').click(function () {
            $('.block.block-search.header__item').addClass('block-active');

            if ($('.page-header').hasClass('sticky')) {
                $('.minisearch input').css({
                    'opacity': '1',
                    'transform': 'scaleX(1)'
                });


            }

        });

    });
</script>

<script>
    require([
        'jquery'
    ], function ($) {
        $(document).ready(function () {
            if ($(window).width() > 768) {
                $(".block-search .actions").append("<span class='button-slide-in'></span>");
                $('html').addClass('ox-search-focuseout');

                $('.button-slide-in').on('click', function () {
                    $('.block.block-search.header__item').removeClass('block-active');
                    $('.header__content .header__item-search form input').focusout();
                    $('html').addClass('ox-search-focuseout');
                });

                $('.button-slide').on('click', function () {
                    $('.header__content .header__item-search form input').focus();
                    $('html').removeClass('ox-search-focuseout');
                    $('.klevu-fluid.kuQuickSearchAutoCompleteLayout').css({
                        'display': 'block'
                    });
                    setTimeout(() => {
                        $('.klevu-fluid.kuQuickSearchAutoCompleteLayout').css({
                            'display': 'block'
                        });
                    }, 500);
                    setTimeout(() => {
                        $('.klevu-fluid.kuQuickSearchAutoCompleteLayout').css({
                            'display': 'block'
                        });
                    }, 1000);
                    setTimeout(() => {
                        $('.klevu-fluid.kuQuickSearchAutoCompleteLayout').css({
                            'display': 'block'
                        });
                    }, 1500);
                    setTimeout(() => {
                        $('.klevu-fluid.kuQuickSearchAutoCompleteLayout').css({
                            'display': 'block'
                        });
                    }, 2000);
                });
            }
        });
    });
</script>
