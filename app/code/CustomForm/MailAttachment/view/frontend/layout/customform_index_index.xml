<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="CustomForm_MailAttachment::css/style.css"/>
    </head>
    <body>
<!--        <referenceBlock name="content">-->
<!--            <block-->
<!--                template="CustomForm_MailAttachment::customform.phtml"-->
<!--                class="Magento\Framework\View\Element\Template"-->
<!--                cacheable="false"/>-->
<!--        </referenceBlock>-->
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="competition.for.recaptcha"
                   template="CustomForm_MailAttachment::customform.phtml">

                <container name="form.additional.info.competition.for.recaptcha">
                    <block class="Magento\ReCaptchaUi\Block\ReCaptcha" name="recaptcha" after="-"
                           template="Magento_ReCaptchaFrontendUi::recaptcha.phtml"
                           ifconfig="recaptcha_frontend/type_for/customform">
                        <arguments>
                            <argument name="recaptcha_for" xsi:type="string">customform</argument>
                            <argument name="jsLayout" xsi:type="array">
                                <item name="components" xsi:type="array">
                                    <item name="recaptcha" xsi:type="array">
                                        <item name="component" xsi:type="string">
                                            Magento_ReCaptchaFrontendUi/js/reCaptcha
                                        </item>
                                    </item>
                                </item>
                            </argument>
                        </arguments>
                    </block>
                </container>
            </block>
        </referenceContainer>
        <referenceBlock name="page.main.title" remove="true"/>
    </body>
</page>
