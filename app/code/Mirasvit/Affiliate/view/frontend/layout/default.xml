<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Mirasvit\Affiliate\Block\Js" name="affiliate_js"/>
        </referenceContainer>

        <referenceBlock name="footer_links">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-link">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Affiliate Program</argument>
                    <argument name="path" xsi:type="string">affiliate/account/welcome</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
