<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="affiliate_account"/>

    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Affiliate Account Settings</argument>
            </action>
        </referenceBlock>

        <referenceContainer name="content">
            <block class="Mirasvit\Affiliate\Block\Account\Edit" name="affiliate_edit" template="account/edit.phtml">
                <block class="Mirasvit\Affiliate\Block\Account\AdditionalData" name="affiliate_edit.additional_data" template="account/additional_data.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
