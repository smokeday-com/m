<?php
declare(strict_types=1);

/**
 * @var \Mirasvit\Affiliate\Block\Account\Promotion\Banners $block
 */

$bannerList = $block->getList();
$account    = $block->getAccount();
?>

<?php if ($account && count($bannerList)): ?>
    <div class="block affiliate-account__promotion-banners">
        <div class="block-title"><strong><?= $block->escapeHtml(__('Banners')) ?></strong></div>
        <div class="block-content">
            <?php foreach ($bannerList as $banner): ?>
                <div class="affiliate__banners-banner">
                    <h3><?= $block->escapeHtml($banner->getTitle()) ?></h3>

                    <div class="affiliate__banner-info">
                        <table class="table data">
                            <tr>
                                <th><?= $block->escapeHtml(__('Type')) ?></th>
                                <td><?= $block->escapeHtml(ucfirst($banner->getType())) ?></td>
                            </tr>
                            <?php if ($banner->getType() == 'image'): ?>
                                <tr>
                                    <th><?= $block->escapeHtml(__('Size')) ?></th>
                                    <td><?= $block->escapeHtml($banner->getWidth() . ' × ' . $banner->getHeight()) ?></td>
                                </tr>
                            <?php endif ?>
                            <tr>
                                <th>
                                    <?= $block->escapeHtml(__('Clicks')) ?>
                                </th>
                                <td>
                                    <?= $block->escapeHtml($block->analyticsService->getBannerClicks($banner, $account)) ?>
                                </td>
                            </tr>
                            <?php if ($banner->getType() == \Mirasvit\Affiliate\Api\Data\BannerInterface::TYPE_IMAGE): ?>
                                <tr>
                                    <th>
                                        <?= $block->escapeHtml(__('Impression')) ?>
                                    </th>
                                    <td>
                                        <?= $block->escapeHtml($block->analyticsService->getBannerImpression($banner, $account)) ?>
                                    </td>
                                </tr>
                            <?php endif ?>
                            <tr>
                                <th><?= $block->escapeHtml(__('Link')) ?></th>
                                <td>
                                    <a href="<?= $block->escapeUrl($banner->getLink()) ?>" target="_blank"><?= $block->escapeHtml($banner->getLink()) ?></a>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="affiliate__banner-preview">
                        <a href="<?= $block->escapeUrl($banner->getLink()) ?>">
                            <?php if ($banner->getType() == 'image'): ?>
                                <img src="<?= $block->escapeUrl($block->bannerManagement->getSourceUrl($banner)) ?>">
                            <?php else: ?>
                                <?= $block->escapeHtml($banner->getSource()) ?>
                            <?php endif ?>
                        </a>
                        <br>
                        <button class="action primary" data-get="<?= $block->escapeHtmlAttr($banner->getId()) ?>"><?= $block->escapeHtml(__('Get Code')) ?></button>
                    </div>

                    <div class="clearfix"></div>

                    <div data-modal="banner-<?= $block->escapeHtmlAttr($banner->getId()) ?>" style="display:none;">
                        <p><?= $block->escapeHtml(__('Copy and paste this code into your website: ')) ?></p>
                        <textarea readonly="readonly" rows="2"
                                  onclick="this.select();"><?= $block->getHtmlCode($banner, $account) ?></textarea>
                    </div>
                </div>
            <?php endforeach ?>
        </div>
    </div>
<?php endif ?>

<script>
    require([
        'jquery',
        'Magento_Ui/js/modal/modal'
    ], function ($, modal) {
        $('[data-get]').on('click', function (e) {
            var $btn = $(e.currentTarget);
            var id = $btn.attr('data-get');
            var $modal = $('[data-modal="banner-' + id + '"]').clone();
            var modal = $modal.modal({
                title: 'Banner Code'
            });
            modal.modal('openModal');
        });
    });
</script>
