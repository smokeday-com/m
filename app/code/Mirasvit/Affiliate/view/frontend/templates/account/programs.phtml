<?php
declare(strict_types=1);
//@codingStandardsIgnoreFile

/** @var \Mirasvit\Affiliate\Block\Widget\Programs $block */

use Mirasvit\Affiliate\Api\Data\ProgramInterface;

/** @var \Magento\Framework\Pricing\Helper\Data $pricingHelper */
$pricingHelper = $this->helper('Magento\Framework\Pricing\Helper\Data');
$collection    = $block->getList();
$account       = $block->getAccount();
$defaultGroup  = $block->getDefaultGroup();
?>

<?php if ($account && $account->getId()): ?>
    <p class="affiliate__promo-title"><?= __('Commissions according to your affiliate group') ?></p>
    <table class="affiliate__widget-programs affiliate__promo-programs" style="width: 100%;">
        <?php foreach ($collection as $program): ?>
            <tr>
                <td class="affiliate__widget-program_name">
                    <?= '<b>' . $program->getName() . '</b> (' . $block->getProgramTypeLabel($program) . ')' ?>
                    <?php if ($program->getDescription()): ?>
                        <p class="affiliate__widget-program_description">
                            <small><?= $program->getDescription() ?></small>
                        </p>
                    <?php endif ?>
                </td>
                <td>
                    <table>
                        <?php foreach ($program->getTiers() as $tier): ?>
                            <?php
                            if ((!$account && $defaultGroup->getId() !== $tier->getGroupId()) || ($account && $account->getGroupId() !== $tier->getGroupId())) {
                                continue;
                            }
                            ?>

                            <tr>
                                <td>
                                    <?php if ($program->getType() == ProgramInterface::TYPE_PAY_PER_SALE): ?>
                                        <?php if ($tier->getType() == ProgramInterface::COMMISSION_TYPE_PERCENT_TOTAL): ?>
                                            <p>• <?= __('<b>%1%</b> of order amount from first order', round($block->getTierAmountFirst($tier), 2)) ?></p>
                                            <p>• <?= __('<b>%1%</b> of order amount from second and more orders', round($block->getTierAmountOther($tier), 2)) ?></p>
                                        <?php elseif ($tier->getType() == ProgramInterface::COMMISSION_TYPE_PERCENT_SUBTOTAL): ?>
                                            <p>• <?= __('<b>%1%</b> of cart amount from first order', round($block->getTierAmountFirst($tier), 2)) ?></p>
                                            <p>• <?= __('<b>%1%</b> of cart amount from second and more orders', round($block->getTierAmountOther($tier), 2)) ?></p>
                                        <?php else: ?>
                                            <p>• <?= __('<b>%1</b> per sale from first order', $pricingHelper->currency($block->getTierAmountFirst($tier), true, false)) ?></p>
                                            <p>• <?= __('<b>%1</b> per sale from second and more orders', $pricingHelper->currency($block->getTierAmountOther($tier), true, false)) ?></p>
                                        <?php endif ?>
                                    <?php elseif ($program->getType() == ProgramInterface::TYPE_PAY_PER_CLICK): ?>
                                        <?= __('<b>%1</b> per unique click', $pricingHelper->currency($block->getTierAmount($tier), true, false)) ?>
                                    <?php elseif ($program->getType() == ProgramInterface::TYPE_PAY_PER_LEAD): ?>
                                        <?= __('<b>%1</b> per lead', $pricingHelper->currency($block->getTierAmount($tier), true, false)) ?>
                                    <?php elseif ($program->getType() == ProgramInterface::TYPE_PAY_PER_IMPRESSION): ?>
                                        <?= __('<b>%1</b> per 1000 views', $pricingHelper->currency($block->getTierAmount($tier), true, false)) ?>
                                    <?php endif ?>
                                </td>
                            </tr>
                        <?php endforeach ?>
                    </table>
                </td>
            </tr>
        <?php endforeach ?>
    </table>
    <p>&nbsp;</p>
<?php endif; ?>
