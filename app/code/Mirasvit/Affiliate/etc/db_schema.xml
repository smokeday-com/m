        <column xsi:type="int" name="coupon_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Coupon Id"/>
        <column xsi:type="int" name="account_id" padding="11" unsigned="false" nullable="false" identity="false" comment="Account"/>
        <column xsi:type="int" name="program_id" padding="11" unsigned="false" nullable="true" identity="false" comment="Program"/>
        <column xsi:type="varchar" name="code" nullable="false" length="255" comment="Coupon Code"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="coupon_id"/>
        </constraint>
        <index referenceId="MST_AFFILIATE_COUPON_ACCOUNT_ID" indexType="btree">
            <column name="account_id"/>
        </index>
        <index referenceId="MST_AFFILIATE_COUPON_CODE" indexType="btree">
            <column name="code"/>
        </index>
    </table>
    <table name="mst_affiliate_account_customer" resource="default" engine="innodb" comment="Account 2 Customer Relations">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Id"/>
        <column xsi:type="int" name="account_id" padding="11" unsigned="false" nullable="false" identity="false" comment="Account"/>
        <column xsi:type="int" name="customer_id" padding="11" unsigned="false" nullable="false" identity="false" comment="Customer"/>
        <column xsi:type="decimal" name="sum_commission" scale="4" precision="12" unsigned="true" nullable="false" default="0" comment="Sum Commission"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
