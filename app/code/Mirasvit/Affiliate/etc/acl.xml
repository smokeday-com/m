<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing">
                    <resource id="Mirasvit_Affiliate::affiliate" title="Affiliates" sortOrder="10">
                        <resource id="Mirasvit_Affiliate::affiliate_dashboard" title="Dashboard" sortOrder="10"/>
                        <resource id="Mirasvit_Affiliate::affiliate_account" title="Accounts" sortOrder="20"/>
                        <resource id="Mirasvit_Affiliate::affiliate_group" title="Affiliate Groups" sortOrder="30"/>
                        <resource id="Mirasvit_Affiliate::affiliate_program" title="Programs" sortOrder="40"/>
                        <resource id="Mirasvit_Affiliate::affiliate_transaction" title="Transactions" sortOrder="50"/>
                        <resource id="Mirasvit_Affiliate::affiliate_banner" title="Banners" sortOrder="60"/>
                        <resource id="Mirasvit_Affiliate::affiliate_withdraw" title="Withdrawals" sortOrder="70"/>
                        <resource id="Mirasvit_Affiliate::affiliate_referred_customers" title="Referred Customers" sortOrder="80"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mirasvit_Affiliate::affiliate_settings" title="Affiliates" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
