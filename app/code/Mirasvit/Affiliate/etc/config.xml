<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <affiliate>
            <general>
                <enabled>1</enabled>
                <show_referred_customers>1</show_referred_customers>
            </general>
            <account>
                <auto_sign_up>0</auto_sign_up>
                <approval_required>0</approval_required>
                <referral_param>acc</referral_param>
                <is_show_link>1</is_show_link>
                <is_show_zero_events>0</is_show_zero_events>
                <account_fields>[{"record_id":"0","key":"website","label":"Referring Website","placeholder":"","type":"text","is_active":"1","is_required":"0"}]</account_fields>
            </account>
            <promotion_materials>
                <widget>
                    <bestsellers_last_days>90</bestsellers_last_days>
                </widget>
            </promotion_materials>
            <commission>
                <include_tax>1</include_tax>
                <add_order_status>complete</add_order_status>
                <subtract_on_creditmemo>1</subtract_on_creditmemo>
                <subtract_order_status>closed</subtract_order_status>
                <holding_period>0</holding_period>
                <cookie_lifetime>365</cookie_lifetime>
                <assign_priority>first</assign_priority>
            </commission>
            <withdraw>
                <min_amount>50</min_amount>
                <autowithdraw_enabled>0</autowithdraw_enabled>
                <payment_method>paypal,skrill,other</payment_method>
                <payment_methods_custom>
                    <item_paypal>
                        <code>paypal</code>
                        <label>PayPal</label>
                        <is_active>1</is_active>
                    </item_paypal>
                    <item_skrill>
                        <code>skrill</code>
                        <label>Skrill</label>
                        <is_active>1</is_active>
                    </item_skrill>
                    <item_other>
                        <code>other</code>
                        <label>Other</label>
                        <is_active>1</is_active>
                    </item_other>
                </payment_methods_custom>
            </withdraw>
            <notification>
                <customer>
                    <account_new_template>affiliate_notification_customer_account_new_template</account_new_template>
                    <account_approved_template>affiliate_notification_customer_account_approved_template</account_approved_template>
                    <transaction_new_template>affiliate_notification_customer_transaction_new_template</transaction_new_template>
                    <update_balance_template>affiliate_notification_customer_update_balance_template</update_balance_template>
                </customer>
                <admin>
                    <account_new_template>affiliate_notification_admin_account_new_template</account_new_template>
                    <withdraw_new_template>affiliate_notification_admin_withdraw_new_template</withdraw_new_template>
                </admin>
            </notification>
            <coupon>
                <enabled>1</enabled>
                <pattern>AFL-[A-Z]{4}</pattern>
            </coupon>
        </affiliate>
    </default>
</config>
