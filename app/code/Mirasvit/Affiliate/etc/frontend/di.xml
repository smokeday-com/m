<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Mirasvit\Affiliate\Controller\AbstractAccount">
        <plugin name="mstAffiliateAuthorization" type="Mirasvit\Affiliate\Plugin\Frontend\AuthorizationPlugin"/>
    </type>

    <type name="Magento\Customer\Controller\Account\CreatePost">
        <plugin name="mstAffiliateCreateAccount" type="Mirasvit\Affiliate\Plugin\Frontend\CreateAccountPlugin"/>
    </type>

    <type name="Magento\Framework\App\Response\Http">
        <plugin name="affiliate" type="Mirasvit\Affiliate\Plugin\Frontend\EnsureAccountRelationsBeforeSendResponsePlugin"/>
        <plugin name="clear_widget" type="Mirasvit\Affiliate\Plugin\Frontend\ClearWidgetBeforeSendResponsePlugin"/>
    </type>

    <!-- 2026-10-26 Dmitrii Fediuk https://github.com/dmitrii-fediuk
    "Prevent Mirasvit_Affiliate from starting a PHP session and emitting Set-Cookie: PHPSESSID on every anonymous frontend request":
    https://github.com/smokeday-com/m/issues/3 -->
    <type name="Mirasvit\Affiliate\Plugin\Frontend\EnsureAccountRelationsBeforeSendResponsePlugin">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <!-- 2026-10-26 Dmitrii Fediuk https://github.com/dmitrii-fediuk
    "Inject Magento\Customer\Model\Session\Proxy into Mirasvit\Affiliate\Service\AccountService to prevent session startup during Response\Http::sendResponse() on FPC HIT":
    https://github.com/smokeday-com/m/issues/6 -->
    <type name="Mirasvit\Affiliate\Service\AccountService">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <type name="Mirasvit\GdprCookie\Model\Config\RequiredCookieList">
        <arguments>
            <argument name="cookies" xsi:type="array">
                <item name="affiliate" xsi:type="string">affiliate</item>
                <item name="affiliate_referrer" xsi:type="string">affiliate_referrer</item>
                <item name="affiliate_identifier" xsi:type="string">affiliate_identifier</item>
            </argument>
        </arguments>
    </type>
</config>
