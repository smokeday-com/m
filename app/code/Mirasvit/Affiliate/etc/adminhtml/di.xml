<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Mirasvit\Core\Block\Adminhtml\Menu">
        <arguments>
            <argument name="menu" xsi:type="array">
                <item name="affiliate" xsi:type="object">Mirasvit\Affiliate\Block\Adminhtml\Menu</item>
            </argument>
        </arguments>
    </type>

    <!--Backend global messages-->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="affiliate_message" xsi:type="string">Mirasvit\Affiliate\Model\Config\ActionRequiredMessage</item>
            </argument>
        </arguments>
    </type>
</config>
