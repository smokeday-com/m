<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Route_Route::css/route.css" />
        <css src="https://fonts.googleapis.com/css?family=Titillium+Web:300,400,600,700"  src_type="url" rel="stylesheet" type="text/css"  />
        <css src="https://fonts.googleapis.com/css?family=Titillium+Web"  src_type="url" rel="stylesheet" type="text/css"  />
    </head>
    <body>
        <referenceContainer name="content">
            <block template="Route_Route::account/creation.phtml"
                   class="Route\Route\Block\Adminhtml\Notification"
                   name="route_account_creation"
                   before="-"/>
            <block template="Route_Route::account/user_failed.phtml"
                   class="Route\Route\Block\Adminhtml\UserNotification"
                   name="route_account_creation_user_failed"
                   before="-"/>
            <block template="Route_Route::account/user_conflicted.phtml"
                   class="Route\Route\Block\Adminhtml\UserConflictedNotification"
                   name="route_account_creation_user_conflicted"
                   before="-"/>
            <block template="Route_Route::account/merchant_failed.phtml"
                   class="Route\Route\Block\Adminhtml\MerchantNotification"
                   name="route_account_creation_merchant_failed"
                   before="-"/>
        </referenceContainer>
    </body>
</page>
