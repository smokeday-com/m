<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">

                                <item name="route_fee" xsi:type="array">
                                    <item name="component"  xsi:type="string">Route_Route/js/view/checkout/cart/totals/fee</item>
                                    <item name="sortOrder" xsi:type="string">30</item>
                                    <item name="config" xsi:type="array">
                                         <item name="template" xsi:type="string">Route_Route/checkout/cart/totals/fee</item>
                                        <item name="title" xsi:type="string" translate="true">Route Insurance Protection</item>
                                    </item>
                                </item>

                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="cart.summary">
            <block name="summary.route.widget.block" ifconfig="route/route/show_on_cart_page" class="Route\Route\Block\Widget\Widget"  template="widget/widget.phtml" before="checkout.cart.methods.bottom" />
        </referenceContainer>
    </body>
</page>
