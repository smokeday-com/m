<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/route/protection" method="POST">
        <service class="Route\Route\Api\ProtectionInterface" method="protect"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/guest-carts/:cartId/route/protection" method="POST">
        <service class="Route\Route\Api\GuestProtectionInterface" method="protect"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>
