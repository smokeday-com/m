                <value id="routeProtectionWidget2" type="host">protection-widget.route.com</value>
                <value id="widgetThemeCDN3" type="host">d3od5si8vgcekb.cloudfront.net</value>
                <value id="lightningWidget2" type="host">protect-lightning-bolt-widget.route.com</value>
                <value id="widgetThemeCDN4" type="host">ddbmicszvqxcg.cloudfront.net</value>
                <value id="grafanaAssets2" type="host">https://unpkg.com</value>
                <value id="routeWobs2" type="host">wobs.route.com</value>
            </values>
        </policy>
    </policies>
