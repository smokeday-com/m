<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="wrong_settings_notification" xsi:type="string">Route\Route\Model\WrongSettingsNotification</item>
                <item name="module_version_check" xsi:type="string">Route\Route\Model\VersionCheckNotification</item>
                <item name="empty_billing_information" xsi:type="string">Route\Route\Model\BillingNotification</item>
            </argument>
        </arguments>
    </type>
</config>
